# Copy to .env and adjust for production deploy.
# Solo use: SQLite on a persistent volume is enough.
# Multi-user later: switch DATABASE_URL to Postgres and add auth with APP_SECRET.

# development | production
ENVIRONMENT=production

# SQLite path (default). For Postgres later:
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/codenda
# DATA_DIR=/app/data

# Comma-separated browser origins (only needed if frontend is on another domain)
# ALLOWED_ORIGINS=https://your-domain.com

# Where uvicorn listens (platforms like Fly/Railway set PORT automatically)
HOST=0.0.0.0
PORT=8001

# Serve frontend/dist from FastAPI (true in Docker/production)
SERVE_STATIC=true

# Future multi-user auth — generate with: python -c "import secrets; print(secrets.token_hex(32))"
APP_SECRET=

{
  "name": "codenda",
  "private": true,
  "scripts": {
    "dev": "npm run dev:clean && concurrently -k \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && python -m uvicorn app.main:app --port 8011 --reload",
    "dev:api:stable": "cd backend && python -m uvicorn app.main:app --port 8011",
    "dev:clean": "powershell -ExecutionPolicy Bypass -File scripts/dev-clean.ps1",
    "dev:web": "powershell -ExecutionPolicy Bypass -File scripts/wait-api.ps1 && cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "start:prod": "python scripts/start-prod.py",
    "init-db": "python scripts/init-db.py",
    "generate-content": "python scripts/generate-content.py",
    "validate-content": "python scripts/validate-content.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}

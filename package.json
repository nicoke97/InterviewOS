{
  "name": "pythonos",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "cd backend && python -m uvicorn app.main:app --reload --port 8000",
    "dev:web": "cd frontend && npm run dev",
    "build": "cd frontend && npm run build",
    "init-db": "python scripts/init-db.py",
    "generate-content": "python scripts/generate-content.py",
    "validate-content": "python scripts/validate-content.py"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
